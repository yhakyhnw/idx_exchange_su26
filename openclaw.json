{
  "$schema": "https://openclaw.ai/config.schema.json",
  "agents": {
    "defaults": {
      "skills": ["real-estate-selector"],
      "models": {
        "openai/gpt-5.4-mini": {
          "alias": "GPT"
        }
      },
      "model": "openai/gpt-5.4-mini"
    },
    "entries": {
      "main": {
        "default": true,
        "skills": ["real-estate-selector"],
        "models": {
          "openai/gpt-5.4-mini": {
            "agentRuntime": {
              "id": "openclaw"
            }
          }
        }
      }
    }
  },
  "skills": {
    "entries": {
      "real-estate-selector": {
        "enabled": true
      }
    }
  },
  "plugins": {
    "entries": {
      "memory-core": {
        "enabled": false
      },
      "heartbeat": {
        "enabled": false
      }
    }
  },
  "tools": {
    "deny": ["web_search", "web_fetch", "x_search"],
    "web": {
      "search": {
        "enabled": false
      },
      "fetch": {
        "enabled": false
      },
      "x_search": {
        "enabled": false
      }
    }
  }
}
